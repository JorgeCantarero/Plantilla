package com.smartstep.Plantilla.controller;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import com.smartstep.Plantilla.model.*;

@RestController
public class SensorController {
    // Controller logic for Medicion

    public void enviarMedicion(Medicion medicion) {
        // Quiero añadir esta medicion a la lista de mediciones del sensor correspondiente
        Plantilla plantilla = obtenerPlantillaPorId(medicion.getId());
        if (plantilla != null) {
            List<Medicion> mediciones = plantilla.getMediciones();
            if (mediciones == null) {
                mediciones = new ArrayList<>();
                plantilla.setMediciones(mediciones);
            }
            mediciones.add(medicion);
        }
    }

    @PostMapping("/tomarMedicion")
    public void tomarMedicion(@RequestBody Medicion medicion, @RequestParam Date fecha, 
        @RequestParam double presion) 
    {
        numSerie = medicion.getId();
        sensorId = medicion.getSensorId();
        Medicion nuevaMedicion = new Medicion(numSerie, presion, fecha, sensorId);
    }
}