
package com.smartstep.Plantilla.controller;

import com.smartstep.Plantilla.model.Medicion;
import com.smartstep.Plantilla.service.MedicionService;

import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/mediciones")
public class MedicionController {

    private final MedicionService medicionService;

    public MedicionController(MedicionService medicionService) {
        this.medicionService = medicionService;
    }

    @PostMapping("/transmitir")
    public void transmitirMediciones(@RequestBody Medicion medicion) {

        medicionService.procesarMedicion(medicion);

    }
}
